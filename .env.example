# -----------------------------------------------------------------------------
# Environment variables for the static website tooling.
#
# These are documentation only. At runtime they are injected by Doppler via
# `doppler run --` (the `dev` script does this for you). Store the real values
# as Doppler secrets, not in a committed .env file.
#
#   doppler setup                 # link this repo to a Doppler project/config
#   doppler secrets set NAME      # add/update a secret
#
# NOTE: Doppler secret names must be UPPERCASE. Terraform expects lowercase
# TF_VAR_<name> variables, so the `dev` script maps the uppercase secrets below
# to the TF_VAR_* names at runtime (e.g. BUCKET_NAME -> TF_VAR_bucket_name).
# GOOGLE_PROJECT / GOOGLE_REGION are reused for both gcloud and Terraform.
# -----------------------------------------------------------------------------

# --- GCP project / auth -------------------------------------------------------

# GCP project ID. Used by gcloud and mapped to TF_VAR_project_id.
GOOGLE_PROJECT=personal-website-503008

# Default region/location. Used by gcloud and mapped to TF_VAR_region.
GOOGLE_REGION=europe-west1

# Service-account key, as the raw JSON contents (single value, not a path).
# Read automatically by the Terraform google provider and used by the dev
# script to authenticate gcloud.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# --- Terraform state backend --------------------------------------------------

# Globally-unique bucket that stores Terraform state. Created by `./dev bootstrap`.
TF_STATE_BUCKET=personal-website-503008-tfstate

# Optional: object prefix within the state bucket (default: terraform/state).
TF_STATE_PREFIX=terraform/state

# --- Website config (mapped to TF_VAR_* by the dev script) --------------------

# Globally-unique bucket name for the website content (-> TF_VAR_bucket_name).
BUCKET_NAME=personal-website-503008-site

# Custom domain (-> TF_VAR_domain_name). Leave empty to provision only the
# public bucket (no HTTPS load balancer / CDN / managed certificate).
DOMAIN_NAME=

# Optional: Cloud CDN url-map name for cache invalidation on deploy.
# Set this after enabling a domain (see `./dev outputs` -> url_map_name).
# Without it, deploy skips invalidation unless terraform state is available.
URL_MAP_NAME=

# --- Local / CI ----------------------------------------------------------------

# Optional: port for `./dev serve` (default 8000). Not a secret; here for reference.
SERVE_PORT=8000
